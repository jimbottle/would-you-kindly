
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Build artifacts
/bin/
/wyk

# goreleaser output (snapshot/release builds)
/dist/


# Claude Code per-machine overrides and roborev's local state — both
# are machine-local; the shared config is .claude/settings.json.
.claude/settings.local.json
/.roborev/

# macOS
.DS_Store

# Netatalk/AFP/SMB "deletion-in-progress" sentinel temp files (.!NNNNN!<name>)
.!*!*

# wyk runtime diagnostic logs — WYK_DEBUG writes wyk-debug.log to the cwd
# (often the repo during dev), and the crash / bd-error logs fall back to
# the cwd when no home dir resolves; rotation adds a ".1". Never commit these.
wyk-debug.log*
wyk-crash.log*
wyk-bd-errors.log*
